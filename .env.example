# Database — local Prisma Postgres, no Docker needed.
#   npm run db:start   (starts the server)
#   npm run db:create  (creates the "nexus" database)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/nexus?sslmode=disable"

# Alternative, if you prefer Docker (npm run db:up):
# DATABASE_URL="postgresql://nexus:nexus@localhost:5432/nexus_classroom?schema=public"

# Auth.js
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"

# File storage: "local" or "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
# S3-compatible (only needed when STORAGE_DRIVER="s3")
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# LiveKit (Meetings module)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
