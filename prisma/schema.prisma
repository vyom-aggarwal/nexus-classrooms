// Nexus Classroom — Prisma schema
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth & Users ----------

enum Role {
  TEACHER
  STUDENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Auth.js adapter models (JWT session strategy today; enables adding an
  // OAuth/SSO provider later without a schema change)
  accounts Account[]
  sessions Session[]

  classesOwned    Class[]           @relation("ClassOwner")
  enrollments     Enrollment[]
  posts           Post[]            @relation("PostAuthor")
  submissions     Submission[]
  gradesGiven     Grade[]           @relation("GradedBy")
  calendarEvents  CalendarEvent[]   @relation("EventCreator")
  meetingSessions MeetingSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Classes & Roster ----------

model Class {
  id          String   @id @default(cuid())
  name        String
  subject     String?
  section     String?
  accentColor String   @default("#6C63FF")
  coverImage  String?
  inviteCode  String   @unique
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation("ClassOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  enrollments    Enrollment[]
  topics         Topic[]
  posts          Post[]
  calendarEvents CalendarEvent[]
}

model Enrollment {
  id       String   @id @default(cuid())
  classId  String
  userId   String
  joinedAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
}

model Topic {
  id      String @id @default(cuid())
  classId String
  title   String
  order   Int    @default(0)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  posts Post[]
}

// ---------- Classwork ----------

enum PostType {
  ANNOUNCEMENT
  ASSIGNMENT
  MATERIAL
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id        String     @id @default(cuid())
  classId   String
  authorId  String
  type      PostType
  status    PostStatus @default(DRAFT)
  title     String
  body      String?    @db.Text
  topicId   String?

  // Assignment-only fields
  dueAt  DateTime?
  points Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  author      User         @relation("PostAuthor", fields: [authorId], references: [id])
  topic       Topic?       @relation(fields: [topicId], references: [id])
  attachments Attachment[]
  submissions Submission[]

  @@index([classId, status])
}

model Attachment {
  id       String  @id @default(cuid())
  postId   String?
  filename String
  url      String
  mimeType String
  size     Int

  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  submissionAttachments SubmissionAttachment[]
}

// ---------- Submissions & Grading ----------

enum SubmissionStatus {
  ASSIGNED
  TURNED_IN
  RETURNED
  MISSING
}

model Submission {
  id          String           @id @default(cuid())
  postId      String
  studentId   String
  status      SubmissionStatus @default(ASSIGNED)
  content     String?          @db.Text
  submittedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  post    Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  attachments SubmissionAttachment[]
  grade       Grade?

  @@unique([postId, studentId])
}

model SubmissionAttachment {
  id           String @id @default(cuid())
  submissionId String
  attachmentId String

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([submissionId, attachmentId])
}

model Grade {
  id           String    @id @default(cuid())
  submissionId String    @unique
  score        Float
  feedback     String?   @db.Text
  gradedById   String
  gradedAt     DateTime  @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gradedBy   User       @relation("GradedBy", fields: [gradedById], references: [id])
}

// ---------- Calendar ----------

enum EventScope {
  CLASS
  PERSONAL
  GLOBAL
}

model CalendarEvent {
  id             String     @id @default(cuid())
  scope          EventScope
  title          String
  description    String?    @db.Text
  startAt        DateTime
  endAt          DateTime
  allDay         Boolean    @default(false)
  location       String?
  isVirtual      Boolean    @default(false)
  recurrenceRule String?

  classId   String?
  creatorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class? @relation(fields: [classId], references: [id], onDelete: Cascade)
  creator User   @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  meeting Meeting?

  @@index([classId])
  @@index([creatorId])
}

// ---------- Meetings ----------

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
}

model Meeting {
  id              String        @id @default(cuid())
  calendarEventId String        @unique
  roomName        String        @unique
  status          MeetingStatus @default(SCHEDULED)
  locked          Boolean       @default(false)
  startedAt       DateTime?
  endedAt         DateTime?

  calendarEvent CalendarEvent    @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  sessions      MeetingSession[]
}

model MeetingSession {
  id        String    @id @default(cuid())
  meetingId String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}
