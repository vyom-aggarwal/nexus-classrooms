    "@prisma/client": "^7.9.1",
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "livekit-client": "^2.21.0",
